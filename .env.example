ASPNETCORE_ENVIRONMENT=Production

DB_HOST=cineabout-db
DB_PORT=1433
DB_NAME=220011
DB_USER=sa
DB_PASSWORD=ChangeMe_Str0ng!
SQL_SA_PASSWORD=ChangeMe_Str0ng!
SQL_MSSQL_PID=Developer

RABBITMQ_HOST=cineabout-rabbitmq
RABBITMQ_USER=admin
RABBITMQ_PASS=ChangeMe_Rabbit1

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ISSUER=CineAbout
JWT_AUDIENCE=CineAboutUsers
# Access token lifetime (hours), refresh token lifetime (hours), password-reset link lifetime (minutes)
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=24
JWT_RESET_EXPIRATION_MINUTES=15

API_HOST_BIND=0.0.0.0
API_HOST_PORT=5218
API_CONTAINER_PORT=5218
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:5218
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# live = the worker sends e-mail (SMTP) and push (Firebase) when configured; test = nothing is sent (use this for any automated test run).
DELIVERY_MODE=live

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENABLE_SSL=true
MAIL_USE_DEFAULT_CREDENTIALS=false
MAIL_USERNAME=CineAbout
MAIL_EMAIL=
MAIL_PASSWORD=

# TMDB "API Read Access Token" (v4 bearer token) from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

FIREBASE_PROJECT_ID=
# Server-side push credentials: the WHOLE service-account JSON on ONE line, in single quotes (keep the quotes; the \n inside the private key stays as it is).
# Shape: FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}'
# Keep the real value only in your local .env (delivered in the encrypted configuration archive), never in Git, an image or a build.
FIREBASE_CREDENTIALS_JSON=
# Optional alternative (used only when FIREBASE_CREDENTIALS_JSON is empty): path of a service-account file on THIS machine, mounted read-only into the worker.
FIREBASE_CREDENTIALS_PATH=
